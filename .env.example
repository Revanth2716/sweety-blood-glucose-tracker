# ---------------------------------------------------------------------------
# Sweety - server environment variables
# Copy this file to `.env` in the repository root and adjust the values.
# Every variable the server reads is listed below. No real secrets belong here.
# ---------------------------------------------------------------------------

# Runtime mode: development | production | test
NODE_ENV=development

# Port the Express API listens on
PORT=4000

# Origin of the React dev server. Used for CORS and for allowed browser origins.
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign JWT access tokens.
# Replace with a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
JWT_SECRET=replace_me_with_a_long_random_secret

# How long a JWT stays valid
JWT_EXPIRES_IN=7d

# Password hashing cost factor (bcrypt rounds)
BCRYPT_ROUNDS=10

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DB_MODE selects the driver:
#   pglite  -> embedded PostgreSQL (WASM), no server required. Great for local dev.
#   postgres -> a real PostgreSQL server reached through DATABASE_URL.
#
# Leave DB_MODE unset to let the app decide: it uses PostgreSQL when DATABASE_URL
# is present, otherwise it falls back to the embedded PGlite database.
DB_MODE=pglite

# Connection string for a real PostgreSQL server (used when DB_MODE=postgres).
# In Docker Compose the API reaches the database at host "db" on port 5432.
DATABASE_URL=postgresql://sweety:sweety@localhost:5432/sweety

# Where the embedded PGlite database stores its data files.
# Use "memory://" for a throw-away in-memory database (every restart starts fresh).
PGLITE_DATA_DIR=./.pglite
