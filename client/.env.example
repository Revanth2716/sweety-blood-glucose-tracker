# ---------------------------------------------------------------------------
# Sweety - client environment variables
# Copy this file to `client/.env.local` (git-ignored) and adjust if needed.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ---------------------------------------------------------------------------

# Base URL of the Sweety REST API.
# Local development: http://localhost:4000/api
# Docker Compose:   /api   (nginx proxies /api to the api container)
VITE_API_URL=http://localhost:4000/api
